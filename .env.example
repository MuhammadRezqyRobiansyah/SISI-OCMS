APP_NAME=SISI-OCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Development: SQLite (default, zero-config)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production: MySQL (uncomment dan isi)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sisi_ocms
# DB_USERNAME=ocms_user
# DB_PASSWORD=                   # ← Isi password yang kuat, JANGAN root tanpa password

# --------------------------------------------------------------------------
# Session
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production session hardening (uncomment untuk produksi):
# SESSION_DRIVER=database
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true     # ← Memerlukan HTTPS! Jika masih HTTP, set false dan catat risiko.
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Google Sheets Integration (Apps Script Web App)
# --------------------------------------------------------------------------
# Lihat tools/gsheet_copy_webapp.gs dan TUTORIAL_GSHEET_SECRET.md
#
# WAJIB DIISI DI PRODUKSI. Integrasi bersifat fail-closed: bila
# GSHEET_COPY_SECRET kosong, seluruh panggilan ke Apps Script ditolak sebelum
# request dikirim, dan fitur GSheet (duplikasi template, scan FR/PR) mati.
#
# GSHEET_COPY_SECRET harus SAMA PERSIS dengan Script Property OCMS_SECRET pada
# Apps Script. Isi nilainya lewat channel aman; jangan pernah commit nilainya.
#
# Rotasi secret:
#   1. Buat nilai acak kuat (mis. 32+ karakter).
#   2. Apps Script → Project Settings → Script Properties → OCMS_SECRET = nilai baru.
#   3. .env produksi → GSHEET_COPY_SECRET = nilai yang sama.
#   4. Apps Script → Deploy → New version.
#   5. php artisan config:cache lalu verifikasi dengan action ping.
GSHEET_COPY_WEBAPP_URL=
GSHEET_COPY_SECRET=

# --------------------------------------------------------------------------
# Production Checklist (jangan deploy sebelum memenuhi semua)
# --------------------------------------------------------------------------
# 1. APP_ENV=production, APP_DEBUG=false
# 2. APP_URL=https://hostname-stabil (bukan IP DHCP)
# 3. APP_KEY sudah di-generate (php artisan key:generate)
# 4. DB_CONNECTION=mysql, user BUKAN root, password kuat
# 5. SESSION_DRIVER=database, SESSION_ENCRYPT=true
# 6. SESSION_SECURE_COOKIE=true (memerlukan HTTPS)
# 7. LOG_LEVEL=warning, LOG_STACK=daily
# 8. GSHEET_COPY_SECRET terisi (fail-closed jika kosong)
# 9. php artisan migrate --force
# 10. php artisan config:cache && php artisan route:cache && php artisan view:cache
# 11. php artisan storage:link
# 12. php artisan ocms:production-check --strict
